{
  "disease_id": "cad",
  "name": "冠心病",
  "department": "心内科",
  "vital_signs": [
    {
      "name": "systolic_mmhg",
      "unit": "mmHg",
      "alert_above": 160,
      "alert_below": null
    },
    {
      "name": "diastolic_mmhg",
      "unit": "mmHg",
      "alert_above": 100,
      "alert_below": null
    },
    {
      "name": "heart_rate",
      "unit": "bpm",
      "alert_below": 50,
      "alert_above": 110
    },
    {
      "name": "troponin",
      "unit": "ng/mL",
      "alert_above": 0.04
    },
    {
      "name": "ldl",
      "unit": "mmol/L",
      "alert_above": 2.6
    }
  ],
  "risk_factors": [
    "post_pci",
    "lvef_lt_40",
    "diabetes_comorbidity",
    "multi_vessel_disease"
  ],
  "monitoring_interval_hours": 6,
  "discharge_criteria": [
    {
      "condition": "chest_pain_free_48h",
      "description": "48h无胸痛发作"
    },
    {
      "condition": "bp_stable",
      "description": "血压稳定在目标范围"
    },
    {
      "condition": "dual_antiplatelet_compliance_verified",
      "description": "双抗依从性已确认"
    },
    {
      "condition": "statin_initiated",
      "description": "他汀已启用"
    }
  ],
  "handoff_instructions": [
    {
      "type": "medication",
      "content": "出院后坚持双抗(阿司匹林+氯吡格雷/替格瑞洛)+他汀，至少12个月"
    },
    {
      "type": "monitoring",
      "content": "每日自测血压心率，关注胸痛、气短症状"
    },
    {
      "type": "followup",
      "content": "出院后2周心内科复查心电图+血脂，同时参加心脏康复"
    }
  ],
  "agent_config": {
    "require_doctor_review": true,
    "discharge_knowledge_keywords": [
      "冠心病二级预防",
      "双抗治疗",
      "心脏康复",
      "血脂管理目标"
    ]
  },
  "followup_questions": [
    {
      "id": "cad-fq-01",
      "question": "近日有无胸痛、胸闷或气短发作？",
      "clinical_intent": "筛查心绞痛复发",
      "source": "ehr-kg"
    },
    {
      "id": "cad-fq-02",
      "question": "抗血小板药物是否按时服用？有无牙龈出血或皮下瘀斑？",
      "clinical_intent": "评估抗栓安全性",
      "source": "ddx-kg"
    },
    {
      "id": "cad-fq-03",
      "question": "是否已开始低盐低脂饮食和规律运动？",
      "clinical_intent": "评估生活方式干预",
      "source": "ehr-kg"
    }
  ],
  "mdt_roles": [
    "心内科",
    "心脏康复师",
    "营养师"
  ],
  "mdt_threshold": "high",
  "history_template": {
    "chief_complaint_required": true,
    "hpi_focus": [
      "chest_pain",
      "radiation",
      "triggers",
      "duration",
      "nitroglycerin_response",
      "exertion_tolerance"
    ],
    "pmh_relevant": [
      "CAD",
      "hypertension",
      "dyslipidemia",
      "diabetes",
      "prior_MI",
      "prior_PCI"
    ],
    "fh_relevant": [
      "premature_CAD",
      "sudden_cardiac_death",
      "dyslipidemia"
    ],
    "sh_required": [
      "smoking",
      "alcohol",
      "diet_fat",
      "exercise",
      "stress"
    ],
    "allergy_required": true,
    "ros_focus_systems": [
      "cardiovascular",
      "respiratory",
      "musculoskeletal"
    ]
  },
  "pe_template": {
    "required_systems": [
      "vital_signs",
      "cardiovascular",
      "respiratory",
      "vascular"
    ],
    "focus_items": [
      "heart_sounds",
      "cardiac_apex",
      "lung_auscultation",
      "peripheral_pulses",
      "carotid_bruit"
    ],
    "neurological_if_indicated": false,
    "fundoscopy": false
  },
  "medication_protocol": {
    "antiplatelet": [
      "aspirin",
      "clopidogrel",
      "ticagrelor"
    ],
    "lipid_management": [
      "atorvastatin_rosuvastatin",
      "ezetimibe"
    ],
    "antianginal": [
      "beta-blocker",
      "CCB",
      "nitrate_prn"
    ],
    "contraindicated": [
      "short_acting_nifedipine",
      "NSAIDs_high_dose"
    ],
    "titration": "他汀目标LDL<1.4mmol/L(极高危)或<1.8(高危)"
  },
  "contraindications": [
    "beta-blocker禁用: 急性心衰/严重心动过缓<50/高度AVB",
    "P2Y12抑制剂禁用: 活动性出血/严重肝功能不全"
  ],
  "severity_grading": {
    "system": "CCS心绞痛分级",
    "grades": [
      {
        "grade": 1,
        "description": "重体力活动诱发心绞痛",
        "risk": "低危"
      },
      {
        "grade": 2,
        "description": "日常活动轻度受限",
        "risk": "中危"
      },
      {
        "grade": 3,
        "description": "日常活动明显受限",
        "risk": "高危"
      },
      {
        "grade": 4,
        "description": "静息心绞痛",
        "risk": "极高危"
      }
    ]
  },
  "complication_monitoring": [
    {
      "complication": "急性心肌梗死",
      "watch": [
        "胸痛>20min",
        "肌钙蛋白升高",
        "ST段抬高或新发LBBB"
      ]
    },
    {
      "complication": "恶性心律失常",
      "watch": [
        "HR>150或<40",
        "晕厥",
        "室速/室颤"
      ]
    },
    {
      "complication": "支架内血栓",
      "watch": [
        "再发胸痛",
        "ECG动态改变",
        "抗血小板药漏服"
      ]
    }
  ],
  "lab_reference": {
    "白细胞": {
      "low": 3.5,
      "high": 9.5
    },
    "血红蛋白": {
      "low": 120,
      "high": 175
    },
    "血小板": {
      "low": 100,
      "high": 300
    },
    "肌酐": {
      "low": 44,
      "high": 104
    },
    "血糖": {
      "low": 3.9,
      "high": 6.1
    },
    "钾": {
      "low": 3.5,
      "high": 5.3
    },
    "钠": {
      "low": 135,
      "high": 145
    },
    "CRP": {
      "low": 0,
      "high": 8
    },
    "肌钙蛋白": {
      "low": 0,
      "high": 0.04
    }
  }
}

{
  "disease_id": "stroke",
  "name": "脑卒中",
  "department": "神经内科",
  "vital_signs": [
    {
      "name": "systolic_mmhg",
      "unit": "mmHg",
      "alert_above": 180,
      "alert_below": null
    },
    {
      "name": "diastolic_mmhg",
      "unit": "mmHg",
      "alert_above": 110,
      "alert_below": null
    },
    {
      "name": "nihss_score",
      "unit": "分",
      "alert_above": 15
    },
    {
      "name": "gcs",
      "unit": "分",
      "alert_below": 8
    },
    {
      "name": "blood_glucose",
      "unit": "mmol/L",
      "alert_above": 10,
      "alert_below": 3.9
    },
    {
      "name": "temperature",
      "unit": "℃",
      "alert_above": 38.0
    }
  ],
  "risk_factors": [
    "age_gt_70",
    "afib_history",
    "hypertension_comorbidity",
    "post_thrombolysis"
  ],
  "monitoring_interval_hours": 4,
  "discharge_criteria": [
    {
      "condition": "nihss_stable_or_improving",
      "description": "NIHSS评分稳定或改善"
    },
    {
      "condition": "bp_controlled",
      "description": "血压控制良好(<140/90)"
    },
    {
      "condition": "swallow_screen_passed",
      "description": "吞咽筛查通过"
    },
    {
      "condition": "mrs_le_3",
      "description": "mRS评分≤3"
    },
    {
      "condition": "gcs_15",
      "description": "GCS 15分/意识清楚"
    }
  ],
  "handoff_instructions": [
    {
      "type": "medication",
      "content": "出院后继续抗血小板/抗凝治疗，严格遵医嘱不可自行停药"
    },
    {
      "type": "monitoring",
      "content": "家属每日监测血压，关注口齿、肢体活动变化"
    },
    {
      "type": "followup",
      "content": "出院后1周神经内科复查，同时开始康复治疗"
    }
  ],
  "agent_config": {
    "require_doctor_review": true,
    "discharge_knowledge_keywords": [
      "脑卒中二级预防",
      "抗血小板治疗",
      "康复训练指南",
      "吞咽障碍护理"
    ]
  },
  "followup_questions": [
    {
      "id": "stroke-fq-01",
      "question": "近日有无新发口齿不清、肢体无力或麻木？",
      "clinical_intent": "筛查卒中复发/进展",
      "source": "ehr-kg"
    },
    {
      "id": "stroke-fq-02",
      "question": "是否出现吞咽困难或进食呛咳？",
      "clinical_intent": "评估吞咽功能",
      "source": "ddx-kg"
    },
    {
      "id": "stroke-fq-03",
      "question": "康复训练是否按计划执行？",
      "clinical_intent": "评估康复依从性",
      "source": "ehr-kg"
    }
  ],
  "mdt_roles": [
    "神经内科",
    "康复师",
    "言语治疗师",
    "营养师"
  ],
  "mdt_threshold": "high",
  "history_template": {
    "chief_complaint_required": true,
    "hpi_focus": [
      "onset_time",
      "NIHSS",
      "last_known_well",
      "weakness",
      "speech",
      "vision",
      "gait",
      "consciousness"
    ],
    "pmh_relevant": [
      "stroke",
      "hypertension",
      "AF",
      "diabetes",
      "dyslipidemia",
      "TIA"
    ],
    "fh_relevant": [
      "stroke",
      "CVD",
      "hypertension",
      "thrombophilia"
    ],
    "sh_required": [
      "smoking",
      "alcohol",
      "drug_abuse",
      "functional_status"
    ],
    "allergy_required": true,
    "ros_focus_systems": [
      "neurological",
      "cardiovascular",
      "musculoskeletal",
      "speech_swallow"
    ]
  },
  "pe_template": {
    "required_systems": [
      "vital_signs",
      "neurological",
      "cardiovascular",
      "musculoskeletal"
    ],
    "focus_items": [
      "NIHSS",
      "cranial_nerves",
      "motor",
      "sensory",
      "cerebellar",
      "gait",
      "GCS",
      "speech"
    ],
    "neurological_if_indicated": true,
    "fundoscopy": true
  },
  "medication_protocol": {
    "antiplatelet": [
      "aspirin",
      "clopidogrel",
      "aspirin_dipyridamole"
    ],
    "anticoagulation": [
      "warfarin_INR2-3",
      "DOAC"
    ],
    "contraindicated": [
      "dual_antiplatelet_long_term_Rx_in_small_vessel"
    ],
    "titration": "急性期48h内评估出血风险后启动抗栓治疗"
  },
  "contraindications": [
    "溶栓绝对禁忌: 活动性出血/近期手术/出血性卒中史",
    "抗凝禁忌: 血小板<50/活动性消化道出血"
  ],
  "severity_grading": {
    "system": "NIHSS",
    "grades": [
      {
        "grade": "轻",
        "nihss_range": "1-4",
        "risk": "低危"
      },
      {
        "grade": "中",
        "nihss_range": "5-15",
        "risk": "中高危"
      },
      {
        "grade": "重",
        "nihss_range": "16-20",
        "risk": "高危"
      },
      {
        "grade": "极重",
        "nihss_range": "21-42",
        "risk": "极高危"
      }
    ]
  },
  "complication_monitoring": [
    {
      "complication": "出血转化",
      "watch": [
        "NIHSS骤增≥4",
        "新发头痛呕吐",
        "意识恶化"
      ]
    },
    {
      "complication": "脑水肿",
      "watch": [
        "意识改变GCS下降",
        "瞳孔不等大",
        "血压升高心率减慢"
      ]
    },
    {
      "complication": "卒中相关性肺炎",
      "watch": [
        "体温>38℃",
        "SpO2<92%",
        "新发肺部啰音"
      ]
    }
  ],
  "lab_reference": {

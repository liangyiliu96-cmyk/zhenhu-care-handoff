      },
      {
        "grade": 4,
        "description": "危及生命",
        "risk": "极高危"
      }
    ]
  },
  "complication_monitoring": [
    {
      "complication": "粒缺伴发热",
      "watch": [
        "T≥38.3℃",
        "中性粒细胞<0.5",
        "寒战",
        "口腔黏膜炎"
      ]
    },
    {
      "complication": "肿瘤溶解综合征",
      "watch": [

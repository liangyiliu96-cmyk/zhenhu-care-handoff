  "medication_protocol": {
    "antiemetic": [
      "NK1_antagonist",
      "5-HT3_antagonist",
      "dexamethasone"
    ],
    "growth_factors": [
      "G-CSF_for_neutropenia",
      "TPO_agonist"
    ],
    "supportive": [
      "bisphosphonate",
      "pain_management"
    ],
    "contraindicated": [
      "live_vaccines",
      "NSAIDs_if_thrombocytopenia"
    ],
    "titration": "每周期化疗后评估毒性分级(CTCAE)调整下周期剂量"
  },
  "contraindications": [
    "活疫苗禁用: 免疫功能低下期",
    "NSAIDs慎用: 血小板减少/肾功能不全",
    "强CYP3A4抑制剂慎用: 与部分化疗药相互作用"
  ],
  "severity_grading": {
    "system": "CTCAE毒性分级",
    "grades": [
      {
        "grade": 1,
        "description": "轻度不良反应",

        "磷升高",
        "Ca<2.1",
        "Cr骤升",
        "尿酸>476"
      ]
    },
    {
      "complication": "严重血小板减少出血",
      "watch": [
        "PLT<20",
        "皮肤瘀斑增多",
        "牙龈/鼻出血"
      ]
    }
  ],

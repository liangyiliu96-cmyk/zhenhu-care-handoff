{
  "disease_id": "delirium",
  "name": "谵妄",
  "department": "老年科",
  "vital_signs": [
    { "name": "systolic_mmhg", "unit": "mmHg", "alert_above": 160, "alert_below": 90 },
    { "name": "diastolic_mmhg", "unit": "mmHg", "alert_above": 100, "alert_below": 60 },
    { "name": "heart_rate", "unit": "bpm", "alert_above": 110, "alert_below": 50 },
    { "name": "spo2", "unit": "%", "alert_below": 92 },
    { "name": "temperature", "unit": "℃", "alert_above": 38.0 },
    { "name": "gcs", "unit": "分", "alert_below": 13 },
    { "name": "respiratory_rate", "unit": "/min", "alert_above": 24 }
  ],
  "risk_factors": [
    "age_gt_75", "dementia_history", "polypharmacy_gt_5_drugs",
    "sensory_impairment", "dehydration", "sleep_deprivation",
    "immobility", "infection", "pain_uncontrolled"
  ],
  "monitoring_interval_hours": 2,
  "discharge_criteria": [
    { "condition": "delirium_resolved_48h", "description": "谵妄症状持续缓解>48h" },
    { "condition": "CAM_negative", "description": "CAM评估阴性" },
    { "condition": "fall_risk_assessed", "description": "跌倒风险评估完成" },
    { "condition": "medication_reviewed", "description": "多重用药审查完成" },
    { "condition": "safe_discharge_environment", "description": "出院环境安全(家庭/康复机构)" }
  ],
  "handoff_instructions": [
    { "type": "medication", "content": "出院带药需家属确认理解，避免多重用药，停用不必要药物" },
    { "type": "monitoring", "content": "家属24h陪护至少3天，观察意识状态、进食、睡眠、排便" },
    { "type": "followup", "content": "出院后1周老年科/精神科门诊复查CAM+MMSE，评估认知恢复" }
  ],
  "agent_config": {
    "require_doctor_review": true,
    "discharge_knowledge_keywords": ["谵妄管理指南", "老年人多重用药", "防跌倒", "认知康复"]
  },
  "followup_questions": [
    { "id": "dl-fq-01", "question": "患者近日意识状态是否清晰？有无胡言乱语或昼夜颠倒？", "clinical_intent": "评估谵妄是否复发", "source": "ehr-kg" },
    { "id": "dl-fq-02", "question": "近期有无跌倒或走路不稳？", "clinical_intent": "评估跌倒风险", "source": "ehr-kg" },
    { "id": "dl-fq-03", "question": "是否按医嘱服药？家属能否正确管理药物？", "clinical_intent": "评估用药管理能力", "source": "ddx-kg" }
  ],
  "mdt_roles": ["老年科", "精神科", "康复师", "临床药师", "营养科"],
  "mdt_threshold": "medium",
  "history_template": {
    "chief_complaint_required": true,
    "hpi_focus": ["confusion_onset", "attention_fluctuation", "sleep_wake_cycle", "precipitating_factors", "baseline_cognition", "medication_changes"],
    "pmh_relevant": ["dementia", "stroke", "Parkinson", "depression", "hearing_loss", "vision_impairment"],
    "fh_relevant": ["dementia", "psychiatric_disorders"],
    "sh_required": ["living_situation", "caregiver_availability", "alcohol", "smoking", "baseline_ADL"],
    "allergy_required": true,
    "ros_focus_systems": ["neurological", "psychiatric", "general", "renal_metabolic"]
  },
  "pe_template": {
    "required_systems": ["vital_signs", "neurological", "psychiatric_mental_status", "cardiovascular"],
    "focus_items": ["CAM_assessment", "MMSE", "attention_test", "level_of_consciousness", "focal_neuro_deficit", "dehydration_signs", "skin_integrity"],
    "neurological_if_indicated": true,
    "fundoscopy": false
  },
  "medication_protocol": {
    "antipsychotic_low_dose": ["haloperidol_0.5mg", "quetiapine_12.5mg", "olanzapine_2.5mg"],
    "non_pharmacologic": ["reorientation", "sleep_hygiene", "early_mobilization", "hearing_vision_aids", "family_presence"],
    "avoid": ["benzodiazepine_Rx_except_alcohol_withdrawal", "anticholinergic", "diphenhydramine_Rx_elderly"],
    "contraindicated": ["physical_restraint_Rx_first_line", "high_dose_antipsychotic_Rx_elderly"],
    "titration": "起始最小剂量抗精神病药，Q12h评估CAM，72h内争取停药"
  },
  "contraindications": ["抗精神病药禁忌: QTc延长/帕金森病", "苯二氮卓禁忌: 非酒精戒断谵妄(加重谵妄)"],
  "severity_grading": {
    "system": "CAM-S严重度",
    "grades": [
      { "grade": "轻", "description": "CAM阳性, 轻度注意力障碍, 定向力可", "risk": "中危" },
      { "grade": "中", "description": "CAM阳性, 明显思维紊乱, 睡眠-觉醒周期紊乱", "risk": "高危" },
      { "grade": "重", "description": "CAM阳性, 躁动或嗜睡, 幻觉, 有跌倒/拔管风险", "risk": "极高危" }
    ]
  },
  "complication_monitoring": [
    { "complication": "跌倒/外伤", "watch": ["Morse评分>45", "躁动不安", "步态不稳"] },
    { "complication": "脱水/营养不良", "watch": ["摄入不足>24h", "皮肤弹性差", "尿素氮升高"] },
    { "complication": "睡眠剥夺恶化", "watch": ["连续48h睡眠<4h", "昼夜颠倒加重"] },
    { "complication": "导管/约束损伤", "watch": ["约束部位皮肤破损", "意外拔管"] }
  ],
  "lab_reference": {
    "白细胞": { "low": 3.5, "high": 10.0 },
    "血红蛋白": { "low": 110, "high": 160 },
    "血小板": { "low": 100, "high": 300 },
    "钠": { "low": 135, "high": 145 },
    "钾": { "low": 3.5, "high": 5.3 },
    "肌酐": { "low": 44, "high": 97 },
    "尿素氮": { "low": 2.5, "high": 7.5 },
    "血糖": { "low": 3.9, "high": 7.8 },
    "CRP": { "low": 0, "high": 8 },
    "TSH": { "low": 0.4, "high": 4.5 },
    "维生素B12": { "low": 200, "high": 900 }
  }
}

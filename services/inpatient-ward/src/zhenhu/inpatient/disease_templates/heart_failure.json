{
  "disease_id": "heart_failure",
  "name": "心力衰竭",
  "department": "心内科",
  "vital_signs": [
    {
      "name": "systolic_mmhg",
      "unit": "mmHg",
      "alert_above": 160,
      "alert_below": 85
    },
    {
      "name": "diastolic_mmhg",
      "unit": "mmHg",
      "alert_above": 100,
      "alert_below": 55
    },
    {
      "name": "heart_rate",
      "unit": "bpm",
      "alert_above": 120,
      "alert_below": 50
    },
    {
      "name": "weight",
      "unit": "kg",
      "alert_if": "体重2天内增加>2kg"
    },
    {
      "name": "spo2",
      "unit": "%",
      "alert_above": 100,
      "alert_below": 92
    },
    {
      "name": "nt_probnp",
      "unit": "pg/mL",
      "alert_above": 5000
    },
    {
      "name": "jvp",
      "unit": "cmH2O",
      "alert_above": 8
    },
    {
      "name": "urine_output",
      "unit": "ml/h",
      "alert_below": 30
    },
    {
      "name": "creatinine",
      "unit": "μmol/L",
      "alert_above": 150
    },
    {
      "name": "potassium",
      "unit": "mmol/L",
      "alert_above": 5.5,
      "alert_below": 3.5
    }
  ],
  "risk_factors": [
    "age>65",
    "ef<40%",
    "nyha_class_iii_iv",
    "renal_insufficiency",
    "prior_hospitalization"
  ],
  "monitoring_interval_hours": 2,
  "discharge_criteria": [
    {
      "condition": "clinical_euvolemia_24h",
      "description": "临床容量正常24小时(无水肿/啰音/颈静脉怒张)"
    },
    {
      "condition": "stable_hemodynamics",
      "description": "口服药物下血流动力学稳定24小时"
    },
    {
      "condition": "self_care_education_done",
      "description": "完成自我管理教育(称重/限钠/症状识别)"
    },
    {
      "condition": "medication_titrated",
      "description": "GDMT药物已启动或达到目标剂量"
    }
  ],
  "handoff_instructions": [
    {
      "type": "medication",
      "content": "GDMT四联用药方案:β-blocker+ACEi/ARB/ARNI+MRA+SGLT2i"
    },
    {
      "type": "monitoring",
      "content": "每日清晨排尿后称体重,记录;体重2天内增加>2kg需就诊"
    },
    {
      "type": "followup",
      "content": "出院7-14天内心衰门诊复诊,定期复查电解质和肾功能"
    }
  ],
  "agent_config": {
    "require_doctor_review": true,
    "discharge_knowledge_keywords": [
      "心衰GDMT用药",
      "限钠限水指导",
      "体重监测方法",
      "心衰恶化识别"
    ]
  },
  "followup_questions": [
    {
      "id": "hf-fq-01",
      "question": "近3天清晨排尿后体重是否稳定？有无2天内增加>2kg？",
      "clinical_intent": "评估容量状态",
      "source": "ehr-kg"
    },
    {
      "id": "hf-fq-02",
      "question": "是否出现夜间阵发性呼吸困难或端坐呼吸？",
      "clinical_intent": "筛查心衰恶化",
      "source": "ddx-kg"
    },
    {
      "id": "hf-fq-03",
      "question": "GDMT四联药物是否全部按时服用？有无漏服或自行减量？",
      "clinical_intent": "评估药物依从性",
      "source": "ehr-kg"
    }
  ],
  "mdt_roles": [
    "心内科",
    "临床药师",
    "营养师"
  ],
  "mdt_threshold": "high",
  "history_template": {
    "chief_complaint_required": true,
    "hpi_focus": [
      "dyspnea",
      "orthopnea",
      "PND",
      "edema",
      "exercise_tolerance",
      "fluid_intake"
    ],
    "pmh_relevant": [
      "heart_failure",
      "hypertension",
      "CAD",
      "CKD",
      "AF"
    ],
    "fh_relevant": [
      "CVD",
      "cardiomyopathy",
      "sudden_cardiac_death"
    ],
    "sh_required": [
      "smoking",
      "alcohol",
      "sodium_intake",
      "fluid_restriction",
      "daily_weight"
    ],
    "allergy_required": true,
    "ros_focus_systems": [
      "cardiovascular",
      "respiratory",
      "renal",
      "gastrointestinal"
    ]
  },
  "pe_template": {
    "required_systems": [
      "vital_signs",
      "cardiovascular",
      "respiratory",
      "abdominal",
      "lower_extremities"
    ],
    "focus_items": [
      "JVP",
      "hepatojugular_reflux",
      "cardiac_auscultation",
      "lung_auscultation",
      "peripheral_edema",
      "ascites"
    ],
    "neurological_if_indicated": false,
    "fundoscopy": false
  },
  "medication_protocol": {
    "first_line": [
      "ACEI/ARB/ARNI",
      "beta-blocker"
    ],
    "second_line": [
      "MRA_spironolactone",
      "SGLT2i"
    ],
    "diuretic": [
      "furosemide_torsemide"
    ],
    "contraindicated": [
      "verapamil_diltiazem",
      "NSAIDs_high_dose"
    ],
    "titration": "每2周评估调整GDMT剂量至靶剂量或最大耐受量"
  },
  "contraindications": [
    "ACEI/ARB/ARNI禁用: 血管性水肿/双侧肾动脉狭窄/高钾>5.5",
    "beta-blocker禁用: 心源性休克/急性失代偿心衰/严重心动过缓<50"
  ],
  "severity_grading": {
    "system": "NYHA",
    "grades": [
      {
        "grade": 1,
        "description": "体力活动不受限",
        "risk": "低危"
      },
      {
        "grade": 2,
        "description": "体力活动轻度受限",
        "risk": "中危"
      },
      {
        "grade": 3,
        "description": "体力活动明显受限",
        "risk": "高危"
      },
      {
        "grade": 4,
        "description": "静息时也有症状",
        "risk": "极高危"
      }
    ]
  },
  "complication_monitoring": [
    {
      "complication": "心源性休克",
      "watch": [
        "SBP<90mmHg",
        "四肢湿冷",
        "尿量<30ml/h",
        "乳酸>2"
      ]
    },
    {
      "complication": "急性肺水肿",
      "watch": [
        "SpO2<90%",
        "双肺满布湿啰音",
        "粉红色泡沫痰"
      ]
    },
    {
      "complication": "恶性心律失常",
      "watch": [
        "HR>150或<40",
        "晕厥",
        "意识丧失"
      ]
    }
  ],
  "lab_reference": {
    "白细胞": {
      "low": 3.5,
      "high": 9.5
    },
    "血红蛋白": {
      "low": 120,
      "high": 175
    },
    "血小板": {
      "low": 100,

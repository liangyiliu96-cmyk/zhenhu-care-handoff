{
  "disease_id": "diabetes",
  "name": "糖尿病",
  "department": "内分泌科",
  "vital_signs": [
    {
      "name": "blood_glucose_fasting",
      "unit": "mmol/L",
      "alert_above": 16.7,
      "alert_below": 3.9
    },
    {
      "name": "blood_glucose_postprandial",
      "unit": "mmol/L",
      "alert_above": 22.2,
      "alert_below": 3.9
    },
    {
      "name": "systolic_mmhg",
      "unit": "mmHg",
      "alert_above": 140,
      "alert_below": 90
    },
    {
      "name": "diastolic_mmhg",
      "unit": "mmHg",
      "alert_above": 90,
      "alert_below": 60
    },
    {
      "name": "hba1c",
      "unit": "%",
      "alert_above": 9.0,
      "alert_below": 4.0
    },
    {
      "name": "blood_ketone",
      "unit": "mmol/L",
      "alert_above": 1.5
    },
    {
      "name": "potassium",
      "unit": "mmol/L",
      "alert_above": 5.5,
      "alert_below": 3.5
    }
  ],
  "risk_factors": [
    "age>50",
    "diabetes_duration>10y",
    "cvd_history",
    "nephropathy",
    "neuropathy",
    "hypoglycemia_history",
    "foot_ulcer_history",
    "recent_dka"
  ],
  "monitoring_interval_hours": 4,
  "discharge_criteria": [
    {
      "condition": "glucose_stable",
      "description": "血糖波动可控,无严重高/低血糖事件24小时"
    },
    {
      "condition": "ketosis_resolved",
      "description": "酮症/酮症酸中毒已纠正"
    },
    {
      "condition": "insulin_or_medication_plan_set",
      "description": "出院降糖方案(口服药/胰岛素)已制定"
    },
    {
      "condition": "self_monitoring_taught",
      "description": "掌握血糖自我监测方法"
    }
  ],
  "handoff_instructions": [
    {
      "type": "medication",
      "content": "降糖药/胰岛素方案:剂量、时间、注射部位轮换"
    },
    {
      "type": "monitoring",
      "content": "空腹+餐后2h血糖监测,记录血糖日志;低血糖症状识别"
    },
    {
      "type": "followup",
      "content": "出院2周内内分泌科复诊,3个月复查HbA1c"
    }
  ],
  "agent_config": {
    "require_doctor_review": true,
    "discharge_knowledge_keywords": [
      "糖尿病饮食管理",
      "低血糖处理",
      "胰岛素注射教学",
      "糖尿病足部护理"
    ]
  },
  "followup_questions": [
    {
      "id": "dm-fq-01",
      "question": "近3天空腹血糖是否稳定在目标范围内(4.4-7.0 mmol/L)？",
      "clinical_intent": "评估降糖方案有效性",
      "source": "ehr-kg"
    },
    {
      "id": "dm-fq-02",
      "question": "是否出现过心慌、手抖、出冷汗等低血糖症状？",
      "clinical_intent": "筛查低血糖事件",
      "source": "ddx-kg"
    },
    {
      "id": "dm-fq-03",
      "question": "是否掌握胰岛素注射部位轮换方法？有无皮下硬结？",
      "clinical_intent": "评估自我管理能力",
      "source": "ehr-kg"
    }
  ],
  "mdt_roles": [
    "内分泌科",
    "营养师",
    "糖尿病教育师"
  ],
  "mdt_threshold": "high",
  "history_template": {
    "chief_complaint_required": true,
    "hpi_focus": [
      "polydipsia",
      "polyuria",
      "weight_change",
      "hypoglycemia_events",
      "glucose_monitoring",
      "diet_adherence",
      "foot_care"
    ],
    "pmh_relevant": [
      "diabetes",
      "hypertension",
      "dyslipidemia",
      "neuropathy",
      "retinopathy",
      "nephropathy"
    ],
    "fh_relevant": [
      "diabetes",
      "CVD",
      "obesity"
    ],
    "sh_required": [
      "smoking",
      "alcohol",
      "diet",
      "exercise",
      "self_monitoring"
    ],
    "allergy_required": true,
    "ros_focus_systems": [
      "endocrine",
      "cardiovascular",
      "neurological",
      "ophthalmic",
      "renal"
    ]
  },
  "pe_template": {
    "required_systems": [
      "vital_signs",
      "cardiovascular",
      "lower_extremities",
      "neurological"
    ],
    "focus_items": [
      "foot_exam",
      "monofilament_sensory",
      "peripheral_pulses",
      "skin_inspection"
    ],
    "neurological_if_indicated": true,
    "fundoscopy": true
  },
  "medication_protocol": {
    "first_line": [
      "metformin"
    ],
    "second_line": [
      "SGLT2i",
      "GLP-1RA",
      "DPP-4i",
      "sulfonylurea"
    ],
    "insulin": [
      "basal_insulin",
      "basal_bolus",
      "insulin_pump"
    ],
    "contraindicated": [
      "high_dose_thiazide",
      "systemic_steroids_unless_indicated"
    ],
    "titration": "每3天评估血糖谱调整方案，目标空腹4.4-7.0，餐后<10.0"
  },
  "contraindications": [
    "metformin禁用: eGFR<30/急性心衰/肝衰竭",
    "SGLT2i禁用: eGFR<20/反复酮症酸中毒"
  ],
  "severity_grading": {
    "system": "HbA1c分级",
    "grades": [
      {
        "grade": 1,
        "hba1c_range": "<7.0%",
        "risk": "低危"
      },
      {
        "grade": 2,
        "hba1c_range": "7.0-8.5%",
        "risk": "中危"
      },
      {
        "grade": 3,
        "hba1c_range": "8.5-10.0%",
        "risk": "高危"
      },
      {
        "grade": 4,
        "hba1c_range": ">10.0%",
        "risk": "极高危"
      }
    ]
  },
  "complication_monitoring": [
    {
      "complication": "DKA",
      "watch": [
        "血糖>16.7",
        "血酮>1.5",
        "pH<7.30",
        "HCO3<15"
      ]
    },
    {
      "complication": "HHS",
      "watch": [
        "血糖>33.3",
        "血浆渗透压>320",
        "意识改变"
      ]
    },
    {
      "complication": "严重低血糖",
      "watch": [
        "血糖<3.9",
        "意识改变",
        "出冷汗心慌"
      ]
    }
  ],
  "lab_reference": {
    "白细胞": {
      "low": 3.5,
      "high": 9.5
    },
    "血红蛋白": {
      "low": 120,
      "high": 175
    },
    "血小板": {
      "low": 100,
      "high": 300
    },
    "肌酐": {
      "low": 44,
      "high": 104
    },
    "血糖": {
      "low": 3.9,
      "high": 6.1
    },
    "钾": {
      "low": 3.5,
      "high": 5.3
    },
    "钠": {
      "low": 135,
      "high": 145
    },
    "CRP": {
      "low": 0,
      "high": 8
    },
    "糖化血红蛋白": {
      "low": 4,
      "high": 6.5
    }
  }
}

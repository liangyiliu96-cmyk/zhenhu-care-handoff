classDiagram
    class RiskItem {
        +String riskId
        +String category
        +String severity
        +String severityLabel
        +String status
        +Object evidence
        +Object citation
        +Object decision
    }

    class Evidence {
        +String label
        +String resourceType
        +String resourceRef
        +String fieldPath
        +String snippet
        +String capturedAt
        +String source_type
    }

    class Decision {
        +String action
        +String note
        +String reason
        +String actor
        +String decidedAt
    }

    class PocWorkflow {
        +Object case
        +Object snapshot
        +Array~RiskItem~ risks
        +Object taskDraft
        +Array tasks
        +Array audit
        +runAnalysis(actor, options)
        +reviewRisk(role, riskId, action, note)
        +createTaskDraft(role)
        +publish(role)
        +adjustSeverityByDischargeTo()
    }

    class Snapshot {
        +String snapshotId
        +Object patient
    }

    class Patient {
        +String dischargeTo
    }

    RiskItem *-- Evidence : evidence
    RiskItem *-- Decision : decision
    PocWorkflow "1" --> "*" RiskItem : risks
    PocWorkflow "1" --> "1" Snapshot : snapshot
    Snapshot "1" --> "1" Patient : patient

    note for Evidence "P0-6 新增字段"
    note for Decision "P0-3 新增 escalate action + reason 字段"
    note for PocWorkflow "P0-2 新增 adjustSeverityByDischargeTo()"

flowchart TB
  subgraph external["外部系统（阶段 0 模拟 / 阶段 1 真实）"]
    his["HIS/EMR/LIS"]
    idp["医院 IDP（CAS/OIDC）"]
  end

  subgraph zhenhu["臻护 AI 协同平台"]
    subgraph frontend["前端层"]
      wb["clinician-workbench\nReact SPA :5173"]
    end

    subgraph gateway["网关层"]
      gw["inpatient-ward\nFastAPI host :8001 / container :8000"]
    end

    subgraph services["服务层"]
      we["workflow-engine\nFastAPI :8100"]
      ko["knowledge-orchestrator\nFastAPI :8200"]
      fa["fhir-adapter\nFastAPI :8300"]
    end

    subgraph data["数据层"]
      mysql[("MySQL 8.0\n:3306")]
      milvus[("Milvus Lite\n:19530")]
      redis[("Redis 7\n:6379")]
    end

    subgraph async["异步层"]
      celery["Celery Workers"]
    end
  end

  wb --> gw
  gw --> we & ko & fa
  we --> ko & fa
  we --> mysql & redis
  ko --> mysql & milvus & redis
  ko --> celery
  celery --> mysql & milvus
  fa --> mysql
  fa -.-> his
  gw -.-> idp

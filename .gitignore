# Dependencies and package-manager files
node_modules/
.pnpm-store/

# Python virtual environments and caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build, coverage, and test artifacts
dist/
build/
coverage/
output/
**/__pycache__/
**/*.pyc
**/*.egg-info/
.playwright-cli/
playwright-report/
test-results/
.cache/
*.tsbuildinfo
apps/frontend/runtime-frontend.*.log
apps/frontend/build.log
apps/frontend/handoff-*.png
apps/frontend/phase*.png
apps/frontend/score-panel-qa.png

# Runtime databases and backups (seeded automatically, never version-controlled)
*.db
*.sqlite
*.sqlite3
**/backups/
*.log

# Alembic autogenerate scratch database (created by `alembic revision --autogenerate`)
_alembic_tmp.db

# Local environment and secrets
.env
.env.*
!.env.example

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# IDE artifacts
.workbuddy/

# Reference projects (read-only, not under version control)
参考借鉴项目/

# PoC runtime data (not version-controlled)
poc/data/

# Local adapter runtime data (seeded automatically for demos)
services/fhir-adapter/data/*.db

# Local browser QA captures. Keep durable visual evidence under docs/ instead.
tmp-*.png

# Vitest config temp files (generated on each run)
vitest.config.ts.timestamp-*.mjs
*.timestamp-*.mjs

# Vite build output variants (CI/verify builds)
dist-verify/
dist-final/

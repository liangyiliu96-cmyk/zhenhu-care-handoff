# 臻护平台环境变量模板
# 复制为 .env 并按需修改: cp .env.example .env
# 所有变量均有默认值, 不配置也可用规则引擎 + mock 数据运行。

# ═══════════════ Docker Compose 编排 ═══════════════

# ---- 数据库 ----
# MySQL root 密码 (生产环境务必修改!)
MYSQL_ROOT_PASSWORD=zhenhu_root
# 业务账号 (镜像自动创建, 三库已由 init 脚本授权)
MYSQL_USER=zhenhu
MYSQL_PASSWORD=zhenhu123
# 宿主机映射端口 (默认 3306; 与本机已有 MySQL 冲突时修改)
MYSQL_HOST_PORT=3306

# ---- 端口映射 ----
REDIS_HOST_PORT=6379
WORKFLOW_HOST_PORT=8100
KNOWLEDGE_HOST_PORT=8200
FHIR_HOST_PORT=8300
INPATIENT_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
KEYCLOAK_HOST_PORT=8080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Neo4j 证据图谱 ----
# 图数据库认证与连接 (演示默认 neo4j/password; 生产务必修改密码)
NEO4J_PASSWORD=password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# ---- 统一鉴权 (Keycloak OIDC) ----
# Keycloak 管理控制台 (http://localhost:8080) 初始管理员
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# 鉴权模式: header (开发演示) / oidc (生产强制); 生产 .env 设为 oidc
AUTH_MODE=header
AUTH_ISSUER=http://keycloak:8080/realms/zhenhu
AUTH_JWKS_URL=http://keycloak:8080/realms/zhenhu/protocol/openid-connect/certs
AUTH_AUDIENCE=zhenhu-web

# ---- LLM (可选) ----
# DeepSeek API 密钥; 未设置时回退到规则引擎, 不影响核心临床流程
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- 运行行为 ----
# 运行环境: dev / production (production 强制要求非 SQLite 数据库)
APP_ENV=production
# 医生自动审批 (生产建议 false)
DOCTOR_AUTO_APPROVE=false
# 日志级别
LOG_LEVEL=info
# CORS 白名单 (前端容器同域代理, 一般无需修改)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 监控 (仅 --profile monitoring) ----
# 告警 webhook 接收地址 (临床告警推送, 生产必配)
ALERTMANAGER_CRITICAL_WEBHOOK_URL=
ALERTMANAGER_WARNING_WEBHOOK_URL=

# ═══════════════ 本地开发 (非容器) ═══════════════

# ---- FHIR 同步 (开发模式可跳过) ----
# 设为 true 时跳过 FHIR HTTP 调用, 使用内置 mock 数据 (测试/离线开发)
SKIP_BRIDGE=false
# FHIR Adapter 服务地址 (容器内为 http://fhir-adapter:8300)
FHIR_ADAPTER_URL=http://127.0.0.1:8300/fhir

# ---- Agent 编排 ----
# Agent 编排模式: classic (节点直调) / langgraph
GRAPH_MODE=classic
# 病例状态过期时间 (秒)
STATE_TTL_SECONDS=1800
# LangGraph 检查点数据库 (留空使用内存)
LANGGRAPH_CHECKPOINT_DB=

# ---- 数据库 (本地开发默认 SQLite) ----
# 生产环境建议使用 MySQL: mysql+asyncmy://user:pass@host:3306/zhenhu_workflow
DATABASE_URL=
# 复杂推理节点模型 (与 DEEPSEEK_MODEL 一致即全部用 flash 档)\nDEEPSEEK_MODEL_PRO=deepseek-chat

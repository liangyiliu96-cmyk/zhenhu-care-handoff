# 臻护平台环境变量模板
# 复制为 .env 并按需修改: cp .env.example .env
# 所有变量均有默认值, 不配置也可用规则引擎 + mock 数据运行。

# ---- LLM (可选) ----
# DeepSeek API 密钥; 未设置时回退到规则引擎, 不影响核心临床流程
DEEPSEEK_API_KEY=

# ---- FHIR 同步 (开发模式可跳过) ----
# 设为 true 时跳过 FHIR HTTP 调用, 使用内置 mock 数据 (测试/离线开发)
SKIP_BRIDGE=false
# FHIR Adapter 服务地址
FHIR_ADAPTER_URL=http://127.0.0.1:8300/fhir

# ---- 住院协同服务 (inpatient-ward) ----
# 服务监听端口 (宿主机 8001, 容器内 8000)
INPATIENT_PORT=8001
# 运行环境: dev / production
APP_ENV=dev
# Agent 编排模式: classic (节点直调) / langgraph
GRAPH_MODE=classic
# 医生自动审批 (仅开发环境建议开启)
DOCTOR_AUTO_APPROVE=true
# 病例状态过期时间 (秒)
STATE_TTL_SECONDS=1800
# LangGraph 检查点数据库 (留空使用内存)
LANGGRAPH_CHECKPOINT_DB=

# ---- 数据库 (可选, 默认 SQLite) ----
# 生产环境建议使用 MySQL: mysql+asyncmy://user:pass@host:3306/zhenhu_workflow
DATABASE_URL=

# 前端环境变量模板
# 复制为 .env.development 并按需修改

# API 基础路径: 留空则同源请求, 由 Vite 代理到后端
VITE_API_BASE=
# 开发代理目标 (inpatient-ward 宿主机入口)
VITE_DEV_API_TARGET=http://127.0.0.1:8001
# 认证模式: header (开发) / oidc (生产)
VITE_AUTH_MODE=header
# 开发环境一键登录快捷入口
VITE_ENABLE_DEV_SHORTCUT_LOGIN=true
# OIDC 登录页 (生产环境接入企业 SSO 时配置)
VITE_OIDC_LOGIN_URL=
